# API keys live in ~/.config/job-search-agent/.env. A .env in the checkout is not read.
.env

# User data: resume, job preferences, generated files, evaluations database and eval set.
# Created from data.example/. Not regenerable.
/data/

# Python
__pycache__/
*.pyc

# Local-only tool permission overrides (see .claude/settings.json for shared config)
.claude/settings.local.json

# Local git worktrees - each is a full checkout of another branch, not repo content
.trees/

# Playwright MCP page snapshots and screenshots: they hold the browsed pages, including user data
.playwright-mcp/
