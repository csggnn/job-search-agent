# API keys live in ~/.config/job-search-agent/.env. A .env in the checkout is not read.
.env

# The personal profile: the user's resume, preferences, generated state and eval set
profiles/personal/
profiles/.personal.restore/

# Generated state and eval set of the default profile, rebuilt from its resume.md and
# job_preferences.md
profiles/default/evaluations.db
profiles/default/compatibility_rubric.json
profiles/default/search_queries.json
profiles/default/evals/

# Python
__pycache__/
*.pyc

# Local-only tool permission overrides (see .claude/settings.json for shared config)
.claude/settings.local.json

# Local git worktrees - each is a full checkout of another branch, not repo content
.trees/
